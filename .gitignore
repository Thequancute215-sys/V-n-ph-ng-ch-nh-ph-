# cấu hình riêng của từng máy (có thể chứa khóa xem) — KHÔNG đưa lên GitHub
/config.json
/config.json.bak
node_modules/
*.log
*.pid
.cloudflared/

# sổ điều phối của từng đội (việc, hòm thư, lượt DEV…) — dữ liệu riêng, không đưa lên GitHub
data/

scratch/

# Understand Anything: chỉ commit đồ thị, không commit phần nháp
.ua/intermediate/
.ua/tmp/
.ua/diff-overlay.json
.ua/.trash-*/

# Cấu hình Claude Code riêng của từng máy. Ghi ở đây (không chỉ trong ~/.config/git/ignore) để Git trong sandbox của Codex,
# vốn không đọc được hồ sơ người dùng, cũng thấy repo sạch.
.claude/settings.local.json
